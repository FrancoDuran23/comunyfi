# Celo mainnet. No pongas secretos reales en este archivo.
CELO_RPC_URL=https://forno.celo.org
CELO_CHAIN_ID=42220

# wARS (Ripio), 18 decimales.
WARS_TOKEN_ADDRESS=0x0dc4f92879b7670e5f4e4e6e3c801d229129d90d

# Clave del agente que custodia el pozo. Vacía = no se puede firmar.
# Hex de 32 bytes, con prefijo 0x. Nunca la subas al repositorio.
AGENT_PRIVATE_KEY=

# Si no ponés la clave, /pozo puede leer esta dirección igual.
AGENT_WALLET=

# true arma las transferencias y no las envía.
# Para un pago real: false, más AGENT_PRIVATE_KEY, más /aprobar CONFIRMAR.
PAYOUT_DRY_RUN=true

# Pozo de ejemplo: ARS 50.000 en wARS. Entero, sin decimales.
# Queda fijado cuando se crea la ronda. Para empezar de cero, borrá la base.
POOL_AMOUNT_WARS=50000

# Anti-abuso: presupuesto por asistente y tope por proyecto.
FICHITAS_PER_ATTENDEE=100
MAX_FICHITAS_PER_PROJECT=40

# Token de @BotFather. Vacío = el bot no arranca.
TELEGRAM_BOT_TOKEN=
# IDs numéricos separados por coma. El bot te muestra el tuyo en /start.
ADMIN_TELEGRAM_IDS=

# Luma. Con API key se consulta el check-in real. Sin key, se usa el archivo.
LUMA_API_KEY=
LUMA_EVENT_ID=evt-reemplazame
# CSV o JSON: email,name,guestId,checkedIn. Solo si no hay API key.
LUMA_GUESTS_FILE=data/guests.example.json

# Base de la ronda. Un reinicio no borra votos.
DATABASE_PATH=data/comunyfi.sqlite

# Identidad ERC-8004. Vacío = el agente figura como no registrado.
ERC8004_REGISTRY_ADDRESS=
ERC8004_AGENT_ID=
ERC8004_AGENT_WALLET=

# Facilitador x402 de Celo. El módulo de pagos sigue siendo un placeholder.
X402_FACILITATOR_URL=https://api.x402.celo.org

# true carga proyectos y el archivo de invitados de ejemplo si la ronda es nueva.
SEED_DEMO=true
PROJECTS_FILE=

# Tablero para el proyector.
# En alwaysdata, IP y PORT las inyecta la plataforma. No las hardcodees allá.
# En local dejá IP sin definir: el proceso escucha en todas las interfaces.
# IP=
PORT=3000

# Producción en alwaysdata. Las dos vacías = long polling (desarrollo local).
# WEBHOOK_URL es el origen público https, sin path y sin barra final.
# Ejemplo: https://comunyfi.alwaysdata.net
WEBHOOK_URL=
# 1 a 256 caracteres: A-Z, a-z, 0-9, _ o -.
# Va en el path /telegram/<secreto> y en el header X-Telegram-Bot-Api-Secret-Token.
WEBHOOK_SECRET=
