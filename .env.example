# Celo mainnet. No pongas secretos reales en este archivo.
CELO_RPC_URL=https://forno.celo.org
CELO_CHAIN_ID=42220

# wARS (Ripio), 18 decimales.
WARS_TOKEN_ADDRESS=0x0dc4f92879b7670e5f4e4e6e3c801d229129d90d

# Clave del agente que custodia el pozo. Dejar vacío en dry-run.
# Hex de 32 bytes, con prefijo 0x. Nunca la subas al repositorio.
AGENT_PRIVATE_KEY=

# true arma las transferencias y no las envía.
PAYOUT_DRY_RUN=true

# Pozo de ejemplo: ARS 50.000 en wARS. Entero, sin decimales.
POOL_AMOUNT_WARS=50000

# Anti-abuso: presupuesto por asistente y tope por proyecto.
FICHITAS_PER_ATTENDEE=100
MAX_FICHITAS_PER_PROJECT=40

# Telegram (grammY). Vacío = el bot no arranca.
TELEGRAM_BOT_TOKEN=
# IDs numéricos separados por coma. Solo ellos pueden /aprobar y /pagar.
ADMIN_TELEGRAM_IDS=

# Luma. El validador de este esqueleto no llama a la API todavía.
LUMA_EVENT_ID=jujuy-dev
# Invitados ya chequeados, separados por coma. Útil para el ensayo.
LUMA_CHECKED_IN_GUESTS=
# true acepta ids con prefijo guest_ sin lista. Solo para demos locales.
LUMA_ALLOW_PLACEHOLDER=true

# Identidad ERC-8004. Vacío = el agente figura como no registrado.
ERC8004_REGISTRY_ADDRESS=
ERC8004_AGENT_ID=
ERC8004_AGENT_WALLET=

# Facilitador x402 de Celo. El módulo de pagos es un placeholder.
X402_FACILITATOR_URL=https://api.x402.celo.org

# true carga data/projects.example.json (destinatarios de relleno).
SEED_DEMO=true
PROJECTS_FILE=

# Tablero para el proyector.
PORT=3000
